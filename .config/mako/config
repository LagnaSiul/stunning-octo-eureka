# Añade esto a tu archivo de configuración de Mako si no lo tienes
icon-path=/usr/share/icons/hicolor
# Configuración Mako estilo Vanta-Black
max-visible=3
output=all
anchor=top-right

# Tipografía (Limpia y minimalista)
font=JetBrainsMono Nerd Font 10
text-color=#ffffff

# Dimensiones y Espaciado
width=320
height=110
margin=15,15
padding=18

# Colores Vanta-Black (Negro absoluto y mate)
background-color=#000000e6
border-size=1
border-color=#1a1a1a
border-radius=4
progress-color=source #333333

# Comportamiento
default-timeout=4000
ignore-timeout=0

# Niveles de Urgencia (Manteniendo la estética oscura)
[urgency=low]
border-color=#111111
text-color=#aaaaaa

[urgency=high]
border-color=#ff0055
default-timeout=0

